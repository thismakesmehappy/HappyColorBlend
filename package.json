    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "bootstrap": "^5.3.0",
    "color-namer": "^1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^11.1.0",
    "wcag-contrast": "^3.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.64.0",
    "@playwright/test": "^1.40.0",
    "@types/color-namer": "^1.3.3",
