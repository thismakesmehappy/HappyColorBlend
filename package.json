{
  "name": "figma-hello-world",
  "version": "1.0.0",
  "description": "A minimal Hello World Figma plugin",
  "type": "module",
  "main": "dist/code.js",
  "scripts": {
    "build": "node --experimental-json-modules ./node_modules/.bin/webpack --mode=production",
    "dev": "node --experimental-json-modules ./node_modules/.bin/webpack --mode=development --watch",
    "preview": "node scripts/preview.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
